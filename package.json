{
  "name": "discog-search",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router build && wrangler dev --config wrangler.jsonc",
    "dev:vite": "vite",
    "preview": "react-router build && wrangler dev --config wrangler.jsonc",
    "deploy": "react-router build && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler dev --config wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types --config wrangler.jsonc && react-router typegen && tsc",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.3",
    "@elysiajs/eden": "^1.4.9",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@sinclair/typebox": "^0.34.49",
    "elysia": "^1.4.29",
    "framer-motion": "^11.11.9",
    "openapi-types": "^12.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.40.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^7.17.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "0BSD",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
