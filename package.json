{
  "name": "discog-search",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router build && wrangler dev --config wrangler.jsonc",
    "dev:vite": "vite",
    "preview": "react-router build && wrangler dev --config wrangler.jsonc",
    "deploy": "react-router build && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler dev --config wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types --config wrangler.jsonc && react-router typegen && tsc",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.10",
    "@elysiajs/eden": "^1.4.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.30",
    "framer-motion": "^11.18.2",
    "openapi-types": "^12.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^7.18.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "bun": ">=1.4.5",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.4.5",
  "license": "0BSD",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "overrides": {
    "@vitest/mocker@>=4.0.0 <4.1.12": "4.1.12",
    "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.32",
    "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
    "browserslist@>=4.0.0 <4.28.7": "4.29.4",
    "nanoid@>=3.0.0 <3.3.18": "3.3.20",
    "postcss@>=8.0.0 <8.5.23": "8.5.31",
    "sharp@>=0.0.0 <0.35.5": "0.35.5",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "zod@>=4.0.0 <4.6.6": "4.6.7"
  }
