{
  "name": "discog-search",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router build && wrangler dev --config wrangler.jsonc",
    "dev:vite": "vite",
    "preview": "react-router build && wrangler dev --config wrangler.jsonc",
    "deploy": "react-router build && wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types --config wrangler.jsonc",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "wrangler dev --config wrangler.jsonc",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types --config wrangler.jsonc && react-router typegen && tsc"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.3",
    "@elysiajs/eden": "^1.4.9",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@sinclair/typebox": "^0.34.49",
    "elysia": "^1.4.29",
    "framer-motion": "^11.11.9",
    "openapi-types": "^12.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^7.17.0",
    "@types/node": "^22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "0BSD",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ]
}
